$Animation "pg_holdshield" "police_animations_extra_anims\pg_holdshield.smd" {
	fps 30
	loop
	weightlist "weights_holdshield"
}

$Animation "pg_holdshield2" "police_animations_extra_anims\pg_holdshield2.smd" {
	fps 30
	loop
	weightlist "weights_holdshield"
}

$Animation "pg_holdshield2_still" "police_animations_extra_anims\pg_holdshield2_still.smd" {
	fps 30
	loop
	weightlist "weights_holdshield"
}

$Animation "pg_holdshield_run" "police_animations_extra_anims\pg_holdshield_run.smd" {
	fps 30
	loop
	weightlist "weights_holdshield"
}

$Animation "pg_holdshield_walk" "police_animations_extra_anims\pg_holdshield_walk.smd" {
	fps 30
	loop
	weightlist "weights_holdshield_walk"
}

$Animation "a_stationed_shield_crouch" "police_animations_extra_anims\a_stationed_shield_crouch.smd" {
	fps 30
	loop
}

$Animation "a_stationed_shield_crouch_setup" "police_animations_extra_anims\a_stationed_shield_crouch_setup.smd" {
	fps 30
}

$Sequence "holdshield" {
	"pg_holdshield"
	fadein 0.2
	fadeout 0.2
	hidden
}

$Sequence "holdshield2" {
	"pg_holdshield2"
	fadein 0.2
	fadeout 0.2
	hidden
}

$Sequence "holdshield2_still" {
	"pg_holdshield2_still"
	fadein 0.2
	fadeout 0.2
	hidden
}

$Sequence "holdshield_run" {
	"pg_holdshield_run"
	fadein 0.2
	fadeout 0.2
	hidden
}

$Sequence "holdshield_walk" {
	"pg_holdshield_walk"
	fadein 0.2
	fadeout 0.2
	hidden
}

$Sequence "batonshieldidle1" {
	"police_animations_extra_anims\batonshieldidle1.smd"
	activity "ACT_IDLE_HOLD_SHIELD" 1
	fadein 0.2
	fadeout 0.2
	addlayer "holdshield2_still"
	node "standing_baton"
	fps 30
	loop
}

$Sequence "batonshieldangryidle1" {
	"police_animations_extra_anims\batonshieldangryidle1.smd"
	activity "ACT_IDLE_ANGRY_HOLD_SHIELD" 1
	fadein 0.2
	fadeout 0.2
	addlayer "holdshield2"
	node "standing_baton"
	fps 30
	loop
}

$Sequence "swingbatonshield" {
	"police_animations_extra_anims\swingbatonshield.smd"
	activity "ACT_MELEE_ATTACK_SWING_SHIELD" 1
	{ event 3001 13 "" }
	fadein 0.2
	fadeout 0.2
	addlayer "holdshield"
	fps 35
}

$Sequence "stationed_shield" {
	"police_animations_extra_anims\stationed_shield.smd"
	activity "ACT_SHIELD_STATIONED" 1
	fadein 0.2
	fadeout 0.2
	fps 30
	loop
}

$Sequence "stationed_shield_crouch" {
	"a_stationed_shield_crouch"
	activity "ACT_SHIELD_STATIONED_CROUCH" 1
	fadein 0.2
	fadeout 0.2
}

$Sequence "stationed_shield_crouch_attack" {
	"police_animations_extra_anims\stationed_shield_crouch_attack.smd"
	activity "ACT_MELEE_ATTACK_SWING_STATIONED_CROUCH" 1
	fadein 0.2
	fadeout 0.2
	fps 30
}

$Sequence "stationed_shield_setup" {
	"a_stationed_shield_crouch_setup"
	activity "ACT_SHIELD_STATIONED_SETUP" 1
	fadein 0.2
	fadeout 0.2
}